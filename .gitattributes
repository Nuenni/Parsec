*.sh text eol=lf

# Parsec branding - always keep our version on a merge conflict with
# upstream (requires `git config merge.ours.driver true` locally, see
# FORK.md). Only binary brand assets and the README, never code/text files -
# merge=ours discards the *entire* file on either side, so it would also
# swallow real upstream fixes anywhere else in a code file.
README.md merge=ours
apps/admin/app/assets/favicon/apple-touch-icon.png merge=ours
apps/admin/app/assets/favicon/favicon.ico merge=ours
apps/admin/public/favicon/android-chrome-192x192.png merge=ours
apps/admin/public/favicon/android-chrome-512x512.png merge=ours
apps/space/app/assets/favicon/apple-touch-icon.png merge=ours
apps/space/app/assets/favicon/favicon.ico merge=ours
apps/space/public/favicon/android-chrome-192x192.png merge=ours
apps/space/public/favicon/android-chrome-512x512.png merge=ours
apps/web/app/assets/favicon/favicon.ico merge=ours
apps/web/app/assets/icons/icon-180x180.png merge=ours
apps/web/app/assets/icons/icon-512x512.png merge=ours
apps/web/public/favicon/android-chrome-192x192.png merge=ours
apps/web/public/favicon/android-chrome-512x512.png merge=ours
apps/web/public/icons/icon-192x192.png merge=ours
apps/web/public/icons/icon-348x348.png merge=ours
apps/web/public/icons/icon-512x512.png merge=ours
apps/web/public/plane-logos/plane-mobile-pwa.png merge=ours